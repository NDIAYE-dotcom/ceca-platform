# CECA-Solutions - example server env
# Copy this file to server/.env and fill values. Never commit real secrets.

# Supabase service role key (KEEP SECRET - used only on server side)
SUPABASE_SERVICE_ROLE_KEY=

# JWT secret for local Express demo server
JWT_SECRET=change_this_in_production

# Server port
PORT=4000

# SMTP settings for sending contact emails
# Example (Gmail SMTP via app password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# FROM_EMAIL=optional-from-address@example.com
# CONTACT_TO_EMAIL=ceconsultingafrique@gmail.com

# Alternatively you can use SendGrid API (recommended)
# SENDGRID_API_KEY=SG.xxxxx
# When set, the server will use SendGrid API to send emails instead of SMTP.
